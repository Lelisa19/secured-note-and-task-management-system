generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

model activity {
  id          String     @id
  action      String
  itemType    String
  itemId      String
  metadata    String?    @db.LongText
  userId      String
  workspaceId String?
  createdAt   DateTime   @default(now())
  user        user       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Activity_userId_fkey")
  workspace   workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "Activity_workspaceId_fkey")

  @@index([userId], map: "Activity_userId_idx")
  @@index([workspaceId], map: "Activity_workspaceId_idx")
}

model announcement {
  id        String   @id
  title     String
  content   String
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive], map: "Announcement_isActive_idx")
}

model favorite {
  id     String  @id
  userId String
  noteId String?
  taskId String?
  note   note?   @relation(fields: [noteId], references: [id], onDelete: Cascade, map: "Favorite_noteId_fkey")
  task   task?   @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "Favorite_taskId_fkey")
  user   user    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Favorite_userId_fkey")

  @@unique([userId, noteId], map: "Favorite_userId_noteId_key")
  @@unique([userId, taskId], map: "Favorite_userId_taskId_key")
  @@index([noteId], map: "Favorite_noteId_fkey")
  @@index([taskId], map: "Favorite_taskId_fkey")
  @@index([userId], map: "Favorite_userId_idx")
}

model file {
  id          String    @id
  name        String
  path        String
  size        Int
  mimeType    String
  workspaceId String
  uploadedBy  String
  createdAt   DateTime  @default(now())
  user        user      @relation(fields: [uploadedBy], references: [id], onDelete: Cascade, map: "File_uploadedBy_fkey")
  workspace   workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "File_workspaceId_fkey")

  @@index([uploadedBy], map: "File_uploadedBy_idx")
  @@index([workspaceId], map: "File_workspaceId_idx")
}

model note {
  id          String      @id
  title       String
  content     String
  status      note_status @default(ACTIVE)
  isEncrypted Boolean     @default(false)
  tags        String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  userId      String
  workspaceId String?
  favorite    favorite[]
  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Note_userId_fkey")
  workspace   workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "Note_workspaceId_fkey")
  noteshare   noteshare[]

  @@index([status], map: "Note_status_idx")
  @@index([userId], map: "Note_userId_idx")
  @@index([workspaceId], map: "Note_workspaceId_idx")
}

model noteshare {
  id                              String    @id
  noteId                          String
  sharedBy                        String
  sharedWith                      String?
  shareLink                       String?   @unique(map: "NoteShare_shareLink_key")
  expiresAt                       DateTime?
  createdAt                       DateTime  @default(now())
  note                            note      @relation(fields: [noteId], references: [id], onDelete: Cascade, map: "NoteShare_noteId_fkey")
  user_noteshare_sharedByTouser   user      @relation("noteshare_sharedByTouser", fields: [sharedBy], references: [id], onDelete: Cascade, map: "NoteShare_sharedBy_fkey")
  user_noteshare_sharedWithTouser user?     @relation("noteshare_sharedWithTouser", fields: [sharedWith], references: [id], onDelete: Cascade, map: "NoteShare_sharedWith_fkey")

  @@index([noteId], map: "NoteShare_noteId_idx")
  @@index([sharedBy], map: "NoteShare_sharedBy_fkey")
  @@index([sharedWith], map: "NoteShare_sharedWith_fkey")
}

model notification {
  id        String   @id
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([isRead], map: "Notification_isRead_idx")
  @@index([userId], map: "Notification_userId_idx")
}

model payment {
  id            String   @id
  userId        String
  amount        Float
  currency      String   @default("USD")
  status        String
  paymentMethod String?
  transactionId String?
  createdAt     DateTime @default(now())
  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Payment_userId_fkey")

  @@index([userId], map: "Payment_userId_idx")
}

model project {
  id          String    @id
  name        String
  description String?
  status      String    @default("ACTIVE")
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  workspace   workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "Project_workspaceId_fkey")
  task        task[]

  @@index([workspaceId], map: "Project_workspaceId_idx")
}

model reminder {
  id       String   @id
  title    String
  message  String?
  remindAt DateTime
  isSent   Boolean  @default(false)
  userId   String
  taskId   String?
  task     task?    @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "Reminder_taskId_fkey")
  user     user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Reminder_userId_fkey")

  @@index([remindAt], map: "Reminder_remindAt_idx")
  @@index([taskId], map: "Reminder_taskId_fkey")
  @@index([userId], map: "Reminder_userId_idx")
}

model role {
  id              String            @id
  name            String
  permissions     String
  workspaceId     String
  createdAt       DateTime          @default(now())
  workspace       workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "Role_workspaceId_fkey")
  workspacemember workspacemember[]

  @@index([workspaceId], map: "Role_workspaceId_idx")
}

model securitylog {
  id        String   @id
  userId    String
  action    String
  ipAddress String?
  userAgent String?
  metadata  String?  @db.LongText
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "SecurityLog_userId_fkey")

  @@index([createdAt], map: "SecurityLog_createdAt_idx")
  @@index([userId], map: "SecurityLog_userId_idx")
}

model subscription {
  id        String            @id
  userId    String            @unique(map: "Subscription_userId_key")
  plan      subscription_plan @default(FREE)
  startDate DateTime          @default(now())
  endDate   DateTime?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime
  user      user              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Subscription_userId_fkey")
}

model supportticket {
  id        String   @id
  userId    String
  subject   String
  message   String
  status    String   @default("OPEN")
  priority  String   @default("MEDIUM")
  createdAt DateTime @default(now())
  updatedAt DateTime
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "SupportTicket_userId_fkey")

  @@index([status], map: "SupportTicket_status_idx")
  @@index([userId], map: "SupportTicket_userId_idx")
}

model task {
  id                         String        @id
  title                      String
  description                String?
  priority                   task_priority @default(MEDIUM)
  status                     task_status   @default(TODO)
  dueDate                    DateTime?
  completedAt                DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime
  userId                     String
  workspaceId                String?
  assigneeId                 String?
  projectId                  String?
  favorite                   favorite[]
  reminder                   reminder[]
  user_task_assigneeIdTouser user?         @relation("task_assigneeIdTouser", fields: [assigneeId], references: [id], map: "Task_assigneeId_fkey")
  project                    project?      @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "Task_projectId_fkey")
  user_task_userIdTouser     user          @relation("task_userIdTouser", fields: [userId], references: [id], onDelete: Cascade, map: "Task_userId_fkey")
  workspace                  workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "Task_workspaceId_fkey")

  @@index([assigneeId], map: "Task_assigneeId_fkey")
  @@index([projectId], map: "Task_projectId_idx")
  @@index([status], map: "Task_status_idx")
  @@index([userId], map: "Task_userId_idx")
  @@index([workspaceId], map: "Task_workspaceId_idx")
}

model user {
  id                                   String            @id
  email                                String            @unique(map: "User_email_key")
  password                             String
  fullName                             String
  avatar                               String?
  role                                 user_role         @default(USER)
  isVerified                           Boolean           @default(false)
  twoFactorEnabled                     Boolean           @default(false)
  twoFactorSecret                      String?
  createdAt                            DateTime          @default(now())
  updatedAt                            DateTime
  activity                             activity[]
  favorite                             favorite[]
  file                                 file[]
  note                                 note[]
  noteshare_noteshare_sharedByTouser   noteshare[]       @relation("noteshare_sharedByTouser")
  noteshare_noteshare_sharedWithTouser noteshare[]       @relation("noteshare_sharedWithTouser")
  notification                         notification[]
  payment                              payment[]
  reminder                             reminder[]
  securitylog                          securitylog[]
  subscription                         subscription?
  supportticket                        supportticket[]
  task_task_assigneeIdTouser           task[]            @relation("task_assigneeIdTouser")
  task_task_userIdTouser               task[]            @relation("task_userIdTouser")
  workspace                            workspace[]
  workspacemember                      workspacemember[]

  @@index([email], map: "User_email_idx")
}

model workspace {
  id              String            @id
  name            String
  description     String?
  logo            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  ownerId         String
  activity        activity[]
  file            file[]
  note            note[]
  project         project[]
  role            role[]
  task            task[]
  user            user              @relation(fields: [ownerId], references: [id], onDelete: Cascade, map: "Workspace_ownerId_fkey")
  workspacemember workspacemember[]

  @@index([ownerId], map: "Workspace_ownerId_idx")
}

model workspacemember {
  id          String    @id
  workspaceId String
  userId      String
  roleId      String?
  joinedAt    DateTime  @default(now())
  isActive    Boolean   @default(true)
  role        role?     @relation(fields: [roleId], references: [id], map: "WorkspaceMember_roleId_fkey")
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "WorkspaceMember_userId_fkey")
  workspace   workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "WorkspaceMember_workspaceId_fkey")

  @@unique([workspaceId, userId], map: "WorkspaceMember_workspaceId_userId_key")
  @@index([roleId], map: "WorkspaceMember_roleId_fkey")
  @@index([userId], map: "WorkspaceMember_userId_idx")
}

enum subscription_plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum note_status {
  ACTIVE
  ARCHIVED
  TRASHED
}

enum task_priority {
  LOW
  MEDIUM
  HIGH
}

enum task_status {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum user_role {
  USER
  ADMIN
}
